{
  "seed": 42,

  "raw_csv": "data/raw/kazakh_profanity_share.csv",
  "label_revisions": "data/label_revisions.csv",
  "processed_dir": "data/processed",
  "near_duplicate_threshold": 0.9,

  "model_name": "FacebookAI/xlm-roberta-base",
  "output_dir": "artifacts/model",
  "results_dir": "results",

  "max_length": 128,
  "window_stride": 64,
  "batch_size": 16,
  "eval_batch_size": 32,
  "learning_rate": 3e-5,
  "weight_decay": 0.01,
  "num_epochs": 6,
  "warmup_ratio": 0.1,
  "max_grad_norm": 1.0,
  "freeze_word_embeddings": true,
  "early_stopping_patience": 2
}
